{"timestamp": "2026-04-15T18:59:12.637096+00:00", "event": "tool_response", "tool": "get_node_definition_detail", "response": {"content": [{"type": "text", "text": "{\"id\":\"trex\",\"boot\":{\"timeout\":60,\"completed\":[\"VIRL^2 TRex Node\"]},\"sim\":{\"linux_native\":{\"libvirt_domain_driver\":\"kvm\",\"driver\":\"server\",\"disk_driver\":\"virtio\",\"ram\":512,\"cpus\":1,\"cpu_limit\":100,\"nic_driver\":\"virtio\"}},\"general\":{\"nature\":\"server\",\"description\":\"Alpine Linux\",\"read_only\":true},\"configuration\":{\"generator\":{\"driver\":\"alpine\"},\"provisioning\":{\"files\":[{\"editable\":true,\"name\":\"node.cfg\",\"content\":\"# this is a shell script which will be sourced at boot\\nhostname inserthostname-here\\n# configurable user account\\nUSERNAME=cisco\\nPASSWORD=cisco\\n\"}],\"media_type\":\"iso\",\"volume_name\":\"cfg\"}},\"device\":{\"interfaces\":{\"serial_ports\":1,\"physical\":[\"eth0\",\"eth1\",\"eth2\"],\"has_loopback_zero\":false,\"default_count\":2,\"management\":[\"eth0\"]}},\"ui\":{\"label_prefix\":\"trex-\",\"icon\":\"access_point\",\"label\":\"TRex\",\"visible\":true,\"group\":\"Others\",\"description\":\"Cisco TRex Traffic Generator\\n\\n(runs in *stateless* mode)\\n\\n512 MB DRAM\\n\\n##### Users\\nThe user account is configurable (cisco/cisco by default).\\n\\n##### Important\\nTRex **MUST** have at least 2 interfaces. The first interface is used for\\nmanagement (consider to connect it using a bridged external connector and\\ngiving it a static IP so that a GUI can be connected to it), the 2nd and\\n3rd interface is for data. The 3rd interface is optional.\\n\\nThe GUI can be downloaded from\\n[here](https://github.com/cisco-system-traffic-generator/trex-stateless-gui),\\nsearch for \\\"Builds\\\". Ensure the version matches the image.\\n\"},\"inherited\":{\"image\":{\"ram\":true,\"cpus\":true,\"data_volume\":true,\"boot_disk_size\":true,\"cpu_limit\":true},\"node\":{\"ram\":true,\"cpus\":true,\"data_volume\":true,\"boot_disk_size\":true,\"cpu_limit\":true}},\"schema_version\":\"0.0.1\"}", "annotations": null, "meta": null}], "structured_content": {"id": "trex", "boot": {"timeout": 60, "completed": ["VIRL^2 TRex Node"]}, "sim": {"linux_native": {"libvirt_domain_driver": "kvm", "driver": "server", "disk_driver": "virtio", "ram": 512, "cpus": 1, "cpu_limit": 100, "nic_driver": "virtio"}}, "general": {"nature": "server", "description": "Alpine Linux", "read_only": true}, "configuration": {"generator": {"driver": "alpine"}, "provisioning": {"files": [{"editable": true, "name": "node.cfg", "content": "# this is a shell script which will be sourced at boot\nhostname inserthostname-here\n# configurable user account\nUSERNAME=cisco\nPASSWORD=cisco\n"}], "media_type": "iso", "volume_name": "cfg"}}, "device": {"interfaces": {"serial_ports": 1, "physical": ["eth0", "eth1", "eth2"], "has_loopback_zero": false, "default_count": 2, "management": ["eth0"]}}, "ui": {"label_prefix": "trex-", "icon": "access_point", "label": "TRex", "visible": true, "group": "Others", "description": "Cisco TRex Traffic Generator\n\n(runs in *stateless* mode)\n\n512 MB DRAM\n\n##### Users\nThe user account is configurable (cisco/cisco by default).\n\n##### Important\nTRex **MUST** have at least 2 interfaces. The first interface is used for\nmanagement (consider to connect it using a bridged external connector and\ngiving it a static IP so that a GUI can be connected to it), the 2nd and\n3rd interface is for data. The 3rd interface is optional.\n\nThe GUI can be downloaded from\n[here](https://github.com/cisco-system-traffic-generator/trex-stateless-gui),\nsearch for \"Builds\". Ensure the version matches the image.\n"}, "inherited": {"image": {"ram": true, "cpus": true, "data_volume": true, "boot_disk_size": true, "cpu_limit": true}, "node": {"ram": true, "cpus": true, "data_volume": true, "boot_disk_size": true, "cpu_limit": true}}, "schema_version": "0.0.1"}, "meta": null}}
