ybox\\\": true\\n}\"}],\"media_type\":\"raw\",\"volume_name\":\"cfg\"}},\"device\":{\"interfaces\":{\"serial_ports\":2,\"physical\":[\"eth0\"],\"has_loopback_zero\":false,\"min_count\":1,\"default_count\":1}},\"ui\":{\"label_prefix\":\"te-agent-\",\"icon\":\"server\",\"label\":\"ThousandEyes Agent\",\"visible\":true,\"group\":\"Cisco\",\"description\":\"ThousandEyes Enterprise Agent 1.210.0\\n\"},\"inherited\":{\"image\":{\"ram\":true,\"cpus\":true,\"data_volume\":false,\"boot_disk_size\":false,\"cpu_limit\":true},\"node\":{\"ram\":true,\"cpus\":true,\"data_volume\":false,\"boot_disk_size\":false,\"cpu_limit\":true}},\"schema_version\":\"0.0.1\"}", "annotations": null, "meta": null}], "structured_content": {"id": "thousandeyes-ea", "boot": {"timeout": 30, "completed": ["ThousandEyes Agent starting up", "READY"]}, "sim": {"linux_native": {"libvirt_domain_driver": "docker", "driver": "server", "ram": 2048, "cpus": 1, "cpu_limit": 100}}, "general": {"nature": "server", "description": "ThousandEyes Enterprise Agent (Docker)", "read_only": true}, "configuration": {"generator": {"driver": null}, "provisioning": {"files": [{"editable": false, "name": "boot.sh", "content": "# (sleep 2 && (tail -f /var/log/agent/te-agent.log | tee -a /dev/console) &) &\n(tail -f /var/log/agent/te-agent.log | tee -a /dev/console) &"}, {"editable": true, "name": "environment", "content": "# https://docs.thousandeyes.com/product-documentation/global-vantage-points/enterprise-agents/installing/docker-agent-config-options\nTEAGENT_ACCOUNT_TOKEN=your-token-goes-here\nTEAGENT_INET=4"}, {"editable": false, "name": "config.json", "content": "{\n  \"docker\": {\n    \"image\": \"thousandeyes/enterprise-agent:latest-agent\",\n    \"caps\": [\n      \"AUDIT_WRITE\",\n      \"CHOWN\",\n      \"DAC_OVERRIDE\",\n      \"FOWNER\",\n      \"FSETID\",\n      \"KILL\",\n      \"MKNOD\",\n      \"NET_BIND_SERVICE\",\n      \"NET_RAW\",\n      \"SETFCAP\",\n      \"SETGID\",\n      \"SETUID\",\n      \"SETPCAP\",\n      \"SYS_CHROOT\",\n      \"IPC_LOCK\",\n      \"NET_ADMIN\",\n      \"SYS_ADMIN\"\n    ],\n    \"misc_args\": [\n      \"--memory-swap=2g\",\n      \"--shm-size=512m\"\n    ],\n    \"mounts\": [\n      \"type=bind,source=cfg/boot.sh,target=/boot.sh\"\n    ]\n  },\n  \"shell\": \"/bin/bash\",\n  \"day0cmd\": [ \"/bin/bash\", \"/boot.sh\" ],\n  \"busybox\": true\n}"}], "media_type": "raw", "volume_name": "cfg"}}, "device": {"interfaces": {"serial_ports": 2, "physical": ["eth0"], "has_loopback_zero": false, "min_count": 1, "default_count": 1}}, "ui": {"label_prefix": "te-agent-", "icon": "server", "label": "ThousandEyes Agent", "visible": true, "group": "Cisco", "description": "ThousandEyes Enterprise Agent 1.210.0\n"}, "inherited": {"image": {"ram": true, "cpus": true, "data_volume": false, "boot_disk_size": false, "cpu_limit": true}, "node": {"ram": true, "cpus": true, "data_volume": false, "boot_disk_size": false, "cpu_limit": true}}, "schema_version": "0.0.1"}, "meta": null}}
