{"timestamp": "2026-04-15T18:59:10.915815+00:00", "event": "tool_response", "tool": "get_node_definition_detail", "response": {"content": [{"type": "text", "text": "{\"id\":\"syslog\",\"boot\":{\"timeout\":30,\"completed\":[\"READY\"]},\"sim\":{\"linux_native\":{\"libvirt_domain_driver\":\"docker\",\"driver\":\"server\",\"ram\":512,\"cpus\":1,\"cpu_limit\":100}},\"general\":{\"nature\":\"server\",\"description\":\"Syslog NG server (Docker)\",\"read_only\":true},\"configuration\":{\"generator\":{\"driver\":null},\"provisioning\":{\"files\":[{\"editable\":false,\"name\":\"config.json\",\"content\":\"{\\n  \\\"docker\\\": {\\n    \\\"image\\\": \\\"syslog:3.38\\\",\\n    \\\"mounts\\\": [\\n      \\\"type=bind,source=cfg/boot.sh,target=/boot.sh\\\",\\n      \\\"type=bind,source=cfg/syslog-ng.conf,target=/etc/syslog-ng/syslog-ng.conf\\\"\\n    ]\\n  },\\n  \\\"shell\\\": \\\"/bin/bash\\\",\\n  \\\"day0cmd\\\": [ \\\"/bin/bash\\\", \\\"/boot.sh\\\" ],\\n  \\\"busybox\\\": true\\n}\\n\"},{\"editable\":true,\"name\":\"syslog-ng.conf\",\"content\":\"#############################################################################\\n# Default syslog-ng.conf file which collects all local logs into a\\n# single file called /var/log/messages tailored to container usage.\\n\\n@version: 3.38\\n\\noptions {\\n    # enable verbose logging (needs 4.0)\\n    # log-level(verbose);\\n\\n    # enable debug messages\\n    # stats_freq(1);  # Update statistics every 1 second\\n    flush_lines(0);\\n};\\n\\nsource s_network {\\n    udp(port(514));\\n};\\n\\ndestination d_local {\\n    file(\\\"/var/log/syslog\\\");\\n};\\n\\ndestination d_stdout {\\n    # send logs to stdout\\n    file(\\\"/dev/stdout\\\");\\n};\\n\\nlog {\\n    source(s_network);\\n    destination(d_stdout);\\n    destination(d_local);\\n};\\n\"},{\"editable\":true,\"name\":\"boot.sh\",\"content\":\"# insert more commands here\\n# ip address add dev eth1 10.0.0.1/24\\n# ip link set dev eth1 up\\n#\\n# keep the next line to indicate that the machine is ready\\necho \\\"READY\\\" >/dev/console\\nexit 0\\n\"}],\"media_type\":\"raw\",\"volume_name\":\"cfg\"}},\"device\":{\"interfaces\":{\"serial_ports\":2,\"physical\":[\"eth0\",\"eth1\",\"eth2\",\"eth3\"],\"has_loopback_zero\":false,\"min_count\":1,\"default_count\":4,\"management\":[\"eth0\"]}},\"ui\":{\"label_prefix\":\"syslog-\",\"icon\":\"server\",\"label\":\"Syslog\",\"visible\":true,\"group\":\"Others\",\"description\":\"Syslog NG server 3.38\\n\"},\"inherited\":{\"image\":{\"ram\":true,\"cpus\":true,\"data_volume\":false,\"boot_disk_size\":false,\"cpu_limit\":true},\"node\":{\"ram\":true,\"cpus\":true,\"data_volume\":false,\"boot_disk_size\":false,\"cpu_limit\":true}},\"schema_version\":\"0.0.1\"}", "annotations": null, "meta": null}], "structured_content": {"id": "syslog", "boot": {"timeout": 30, "completed": ["READY"]}, "sim": {"linux_native": {"libvirt_domain_driver": "docker", "driver": "server", "ram": 512, "cpus": 1, "cpu_limit": 100}}, "general": {"nature": "server", "description": "Syslog NG server (Docker)", "read_only": true}, "configuration": {"generator": {"driver": null}, "provisioning": {"files": [{"editable": false, "name": "config.json", "content": "{\n  \"docker\": {\n    \"image\": \"syslog:3.38\",\n    \"mounts\": [\n      \"type=bind,source=cfg/boot.sh,target=/boot.sh\",\n      \"type=bind,source=cfg/syslog-ng.conf,target=/etc/syslog-ng/syslog-ng.conf\"\n    ]\n  },\n  \"shell\": \"/bin/bash\",\n  \"day0cmd\": [ \"/bin/bash\", \"/boot.sh\" ],\n  \"busybox\": true\n}\n"}, {"editable": true, "name": "syslog-ng.conf", "content": "#############################################################################\n# Default syslog-ng.conf file which collects all local logs into a\n# single file called /var/log/messages tailored to container usage.\n\n@version: 3.38\n\noptions {\n    # enable verbose logging (needs 4.0)\n    # log-level(verbose);\n\n    # enable debug messages\n    # stats_freq(1);  # Update statistics every 1 second\n    flush_lines(0);\n};\n\nsource s_network {\n    udp(port(514));\n};\n\ndestination d_local {\n    file(\"/var/log/syslog\");\n};\n\ndestination d_stdout {\n    # send logs to stdout\n    file(\"/dev/stdout\");\n};\n\nlog {\n    source(s_network);\n    destination(d_stdout);\n    destination(d_local);\n};\n"}, {"editable": true, "name": "boot.sh", "content": "# insert more commands here\n# ip address add dev eth1 10.0.0.1/24\n# ip link set dev eth1 up\n#\n# keep the next line to indicate that the machine is ready\necho \"READY\" >/dev/console\nexit 0\n"}], "media_type": "raw", "volume_name": "cfg"}}, "device": {"interfaces": {"serial_ports": 2, "physical": ["eth0", "eth1", "eth2", "eth3"], "has_loopback_zero": false, "min_count": 1, "default_count": 4, "management": ["eth0"]}}, "ui": {"label_prefix": "syslog-", "icon": "server", "label": "Syslog", "visible": true, "group": "Others", "description": "Syslog NG server 3.38\n"}, "inherited": {"image": {"ram": true, "cpus": true, "data_volume": false, "boot_disk_size": false, "cpu_limit": true}, "node": {"ram": true, "cpus": true, "data_volume": false, "boot_disk_size": false, "cpu_limit": true}}, "schema_version": "0.0.1"}, "meta": null}}
