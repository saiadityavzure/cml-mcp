{"timestamp": "2026-04-15T18:59:13.363550+00:00", "event": "tool_response", "tool": "get_node_definition_detail", "response": {"content": [{"type": "text", "text": "{\"id\":\"ubuntu\",\"boot\":{\"timeout\":180,\"completed\":[\"Cloud-init target\",\"Welcome to Ubuntu\",\"running 'modules:final' at\"]},\"sim\":{\"linux_native\":{\"libvirt_domain_driver\":\"kvm\",\"driver\":\"server\",\"disk_driver\":\"virtio\",\"ram\":2048,\"cpus\":1,\"cpu_limit\":100,\"nic_driver\":\"virtio\",\"data_volume\":0,\"boot_disk_size\":64}},\"general\":{\"nature\":\"server\",\"description\":\"Ubuntu Cloud Init Platform\",\"read_only\":true},\"configuration\":{\"generator\":{\"driver\":\"ubuntu\"},\"provisioning\":{\"files\":[{\"editable\":false,\"name\":\"meta-data\",\"content\":\"instance-id: ubuntu\\nlocal-hostname: ubuntu\\n\"},{\"editable\":true,\"name\":\"user-data\",\"content\":\"#cloud-config\\nhostname: inserthostname-here\\nmanage_etc_hosts: True\\nsystem_info:\\n  default_user:\\n    name: cisco\\npassword: cisco\\nchpasswd: { expire: False }\\nssh_pwauth: True\\nssh_authorized_keys:\\n   - your-ssh-pubkey-line-goes-here\\n\"},{\"editable\":true,\"name\":\"network-config\",\"content\":\"#network-config\\nnetwork:\\n  version: 2\\n  ethernets:\\n    ens2:\\n      dhcp4: true\\n\"}],\"media_type\":\"iso\",\"volume_name\":\"cidata\"}},\"device\":{\"interfaces\":{\"serial_ports\":1,\"physical\":[\"ens2\",\"ens3\",\"ens4\",\"ens5\",\"ens6\",\"ens7\",\"ens8\",\"ens9\"],\"has_loopback_zero\":false,\"default_count\":1}},\"ui\":{\"label_prefix\":\"ubuntu-\",\"icon\":\"server\",\"label\":\"Ubuntu\",\"visible\":true,\"group\":\"Others\",\"description\":\"Ubuntu Cloud Init Platform\\n\\n2 GB DRAM, 1 vCPU (can be adjusted)\\n\\n##### Configuration\\n\\nThe Ubuntu image uses cloud-init YAML for configuration. Please\\nensure that you have a valid cloud-init configuration in the node's\\nEdit Config pane in the Workbench. When you drop an Ubuntu node\\non the canvas in the Workbench, a very brief (but complete) skeleton\\nfor a cloud-init configuration is added to the node.\\n\\nThe pre-configured default username on the VM image is ubuntu,\\nbut the initial config for the node overrides the default_user account\\nto be cisco. To log into the node as with this default user account,\\nensure that the cloud-init config for the node either specifies a password\\nwith the top-level password field or provides at least one SSH public key\\nwith the top-level ssh_authorized_keys field.\\n\\nSee [the cloud-init documentation](https://cloudinit.readthedocs.io/en/latest/topics/examples.html)\\nfor additional cloud-init examples.\\n\"},\"inherited\":{\"image\":{\"ram\":true,\"cpus\":true,\"data_volume\":true,\"boot_disk_size\":true,\"cpu_limit\":true},\"node\":{\"ram\":true,\"cpus\":true,\"data_volume\":true,\"boot_disk_size\":true,\"cpu_limit\":true}},\"pyats\":{\"os\":\"linux\"},\"schema_version\":\"0.0.1\"}", "annotations": null, "meta": null}], "structured_content": {"id": "ubuntu", "boot": {"timeout": 180, "completed": ["Cloud-init target", "Welcome to Ubuntu", "running 'modules:final' at"]}, "sim": {"linux_native": {"libvirt_domain_driver": "kvm", "driver": "server", "disk_driver": "virtio", "ram": 2048, "cpus": 1, "cpu_limit": 100, "nic_driver": "virtio", "data_volume": 0, "boot_disk_size": 64}}, "general": {"nature": "server", "description": "Ubuntu Cloud Init Platform", "read_only": true}, "configuration": {"generator": {"driver": "ubuntu"}, "provisioning": {"files": [{"editable": false, "name": "meta-data", "content": "instance-id: ubuntu\nlocal-hostname: ubuntu\n"}, {"editable": true, "name": "user-data", "content": "#cloud-config\nhostname: inserthostname-here\nmanage_etc_hosts: True\nsystem_info:\n  default_user:\n    name: cisco\npassword: cisco\nchpasswd: { expire: False }\nssh_pwauth: True\nssh_authorized_keys:\n   - your-ssh-pubkey-line-goes-here\n"}, {"editable": true, "name": "network-config", "content": "#network-config\nnetwork:\n  version: 2\n  ethernets:\n    ens2:\n      dhcp4: true\n"}], "media_type": "iso", "volume_name": "cidata"}}, "device": {"interfaces": {"serial_ports": 1, "physical": ["ens2", "ens3", "ens4", "ens5", "ens6", "ens7", "ens8", "ens9"], "has_loopback_zero": false, "default_count": 1}}, "ui": {"label_prefix": "ubuntu-", "icon": "server", "label": "Ubuntu", "visible": true, "group": "Others", "description": "Ubuntu Cloud Init Platform\n\n2 GB DRAM, 1 vCPU (can be adjusted)\n\n##### Configuration\n\nThe Ubuntu image uses cloud-init YAML for configuration. Please\nensure that you have a valid cloud-init configuration in the node's\nEdit Config pane in the Workbench. When you drop an Ubuntu node\non the canvas in the Workbench, a very brief (but complete) skeleton\nfor a cloud-init configuration is added to the node.\n\nThe pre-configured default username on the VM image is ubuntu,\nbut the initial config for the node overrides the default_user account\nto be cisco. To log into the node as with this default user account,\nensure that the cloud-init config for the node either specifies a password\nwith the top-level password field or provides at least one SSH public key\nwith the top-level ssh_authorized_keys field.\n\nSee [the cloud-init documentation](https://cloudinit.readthedocs.io/en/latest/topics/examples.html)\nfor additional cloud-init examples.\n"}, "inherited": {"image": {"ram": true, "cpus": true, "data_volume": true, "boot_disk_size": true, "cpu_limit": true}, "node": {"ram": true, "cpus": true, "data_volume": true, "boot_disk_size": true, "cpu_limit": true}}, "pyats": {"os": "linux"}, "schema_version": "0.0.1"}, "meta": null}}
