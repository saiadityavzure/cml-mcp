{"timestamp": "2026-04-15T18:59:08.823423+00:00", "event": "tool_response", "tool": "get_node_definition_detail", "response": {"content": [{"type": "text", "text": "{\"id\":\"net-tools\",\"boot\":{\"timeout\":30,\"completed\":[\"READY\"]},\"sim\":{\"linux_native\":{\"libvirt_domain_driver\":\"docker\",\"driver\":\"server\",\"ram\":512,\"cpus\":1,\"cpu_limit\":100}},\"general\":{\"nature\":\"server\",\"description\":\"Networking tools node (Docker)\",\"read_only\":true},\"configuration\":{\"generator\":{\"driver\":\"server\"},\"provisioning\":{\"files\":[{\"editable\":false,\"name\":\"config.json\",\"content\":\"{\\n  \\\"docker\\\": {\\n    \\\"image\\\": \\\"net-tools:1.0.0\\\",\\n    \\\"mounts\\\": [\\n      \\\"type=bind,source=cfg/boot.sh,target=/boot.sh\\\"\\n    ],\\n    \\\"caps\\\": [\\n      \\\"CAP_CHOWN\\\",\\n      \\\"CAP_DAC_OVERRIDE\\\",\\n      \\\"CAP_FOWNER\\\",\\n      \\\"CAP_FSETID\\\",\\n      \\\"CAP_KILL\\\",\\n      \\\"CAP_MKNOD\\\",\\n      \\\"CAP_NET_BIND_SERVICE\\\",\\n      \\\"CAP_NET_RAW\\\",\\n      \\\"CAP_SETFCAP\\\",\\n      \\\"CAP_SETGID\\\",\\n      \\\"CAP_SETPCAP\\\",\\n      \\\"CAP_SETUID\\\",\\n      \\\"CAP_SYS_CHROOT\\\",\\n      \\\"NET_ADMIN\\\",\\n      \\\"SYS_ADMIN\\\"\\n    ]\\n  },\\n  \\\"day0cmd\\\": [ \\\"/bin/bash\\\", \\\"/boot.sh\\\" ],\\n  \\\"busybox\\\": true\\n}\\n\"},{\"editable\":true,\"name\":\"boot.sh\",\"content\":\"# insert more commands here\\n# ip address add dev eth1 10.0.0.1/24\\n# ip link set dev eth1 up\\n#\\n# keep the next line to indicate that the machine is ready\\necho \\\"READY\\\" >/dev/console\\ncat /etc/motd\\nexit 0\\n\"}],\"media_type\":\"raw\",\"volume_name\":\"cfg\"}},\"device\":{\"interfaces\":{\"serial_ports\":1,\"physical\":[\"eth0\",\"eth1\",\"eth2\",\"eth3\"],\"has_loopback_zero\":false,\"min_count\":1,\"default_count\":4,\"management\":[\"eth0\"]}},\"ui\":{\"label_prefix\":\"net-tools-\",\"icon\":\"server\",\"label\":\"Net-Tools\",\"visible\":true,\"group\":\"Others\",\"description\":\"Networking tools node 1.0.0\\n\"},\"inherited\":{\"image\":{\"ram\":true,\"cpus\":true,\"data_volume\":false,\"boot_disk_size\":false,\"cpu_limit\":true},\"node\":{\"ram\":true,\"cpus\":true,\"data_volume\":false,\"boot_disk_size\":false,\"cpu_limit\":true}},\"schema_version\":\"0.0.1\"}", "annotations": null, "meta": null}], "structured_content": {"id": "net-tools", "boot": {"timeout": 30, "completed": ["READY"]}, "sim": {"linux_native": {"libvirt_domain_driver": "docker", "driver": "server", "ram": 512, "cpus": 1, "cpu_limit": 100}}, "general": {"nature": "server", "description": "Networking tools node (Docker)", "read_only": true}, "configuration": {"generator": {"driver": "server"}, "provisioning": {"files": [{"editable": false, "name": "config.json", "content": "{\n  \"docker\": {\n    \"image\": \"net-tools:1.0.0\",\n    \"mounts\": [\n      \"type=bind,source=cfg/boot.sh,target=/boot.sh\"\n    ],\n    \"caps\": [\n      \"CAP_CHOWN\",\n      \"CAP_DAC_OVERRIDE\",\n      \"CAP_FOWNER\",\n      \"CAP_FSETID\",\n      \"CAP_KILL\",\n      \"CAP_MKNOD\",\n      \"CAP_NET_BIND_SERVICE\",\n      \"CAP_NET_RAW\",\n      \"CAP_SETFCAP\",\n      \"CAP_SETGID\",\n      \"CAP_SETPCAP\",\n      \"CAP_SETUID\",\n      \"CAP_SYS_CHROOT\",\n      \"NET_ADMIN\",\n      \"SYS_ADMIN\"\n    ]\n  },\n  \"day0cmd\": [ \"/bin/bash\", \"/boot.sh\" ],\n  \"busybox\": true\n}\n"}, {"editable": true, "name": "boot.sh", "content": "# insert more commands here\n# ip address add dev eth1 10.0.0.1/24\n# ip link set dev eth1 up\n#\n# keep the next line to indicate that the machine is ready\necho \"READY\" >/dev/console\ncat /etc/motd\nexit 0\n"}], "media_type": "raw", "volume_name": "cfg"}}, "device": {"interfaces": {"serial_ports": 1, "physical": ["eth0", "eth1", "eth2", "eth3"], "has_loopback_zero": false, "min_count": 1, "default_count": 4, "management": ["eth0"]}}, "ui": {"label_prefix": "net-tools-", "icon": "server", "label": "Net-Tools", "visible": true, "group": "Others", "description": "Networking tools node 1.0.0\n"}, "inherited": {"image": {"ram": true, "cpus": true, "data_volume": false, "boot_disk_size": false, "cpu_limit": true}, "node": {"ram": true, "cpus": true, "data_volume": false, "boot_disk_size": false, "cpu_limit": true}}, "schema_version": "0.0.1"}, "meta": null}}
